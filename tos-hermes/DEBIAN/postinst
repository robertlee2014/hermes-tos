#!/bin/bash
# Hermes AI Agent - TOS 7 postinst script
# Installs Python dependencies and downloads WebUI after installation
# Uses HermesWorkspace on the target disk volume for dynamic data

set -e

LOG_FILE="/var/log/hermes-app/install.log"

# Read target volume from preinst
if [ -f "/usr/local/hermes-app/.data_volume" ]; then
    TARGET_VOLUME=$(cat /usr/local/hermes-app/.data_volume)
else
    # Fallback: detect volume again
    TARGET_VOLUME=""
    for vol in /volume1 /volume2 /volume3 /volume4 /volume5; do
        if [ -d "$vol" ] && [ -w "$vol" ]; then
            TARGET_VOLUME="$vol"
            break
        fi
    done
    if [ -z "$TARGET_VOLUME" ]; then
        TARGET_VOLUME="/"
    fi
fi

DATA_DIR="${TARGET_VOLUME}/HermesWorkspace"
VENV_DIR="${DATA_DIR}/venv"
WEBUI_DIR="${DATA_DIR}/hermes-webui"
AGENT_DIR="${DATA_DIR}/hermes-agent"
WORKSPACE_DIR="${DATA_DIR}/workspace"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" | tee -a "${LOG_FILE}"
}

error_exit() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - ERROR: $1" | tee -a "${LOG_FILE}"
    exit 1
}

mkdir -p "${DATA_DIR}" "${WORKSPACE_DIR}" "$(dirname "${LOG_FILE}")"

log_msg "=== Hermes AI Agent Post-Installation ==="
log_msg "Data directory: ${DATA_DIR}"

# ==========================================
# 本地兜底支持：用户可预先上传源码到 DATA_DIR
# ==========================================
LOCAL_AGENT_DIR="${DATA_DIR}/hermes-agent-source"
LOCAL_WEBUI_DIR="${DATA_DIR}/hermes-webui-source"

AGENT_SOURCE_READY=false
WEBUI_SOURCE_READY=false

# pip mirrors fallback chain
PIP_MIRRORS=(
    "https://mirrors.aliyun.com/pypi/simple/"
    "https://pypi.tuna.tsinghua.edu.cn/simple/"
    "https://mirrors.ustc.edu.cn/pypi/web/simple/"
    "https://repo.huaweicloud.com/repository/pypi/simple/"
    "https://mirrors.cloud.tencent.com/pypi/simple/"
    "https://pypi.org/simple/"
)

# GitHub proxies fallback chain
GH_PROXIES=(
    "https://ghproxy.com/"
    "https://gh.api.coderkeeper.com/"
    "https://gitclone.com/"
    "https://gh.ddlc.top/"
    ""
)

# Step 1: Create virtual environment
log_msg "Step 1/6: Creating Python virtual environment..."
if [ ! -f "${VENV_DIR}/bin/python3" ]; then
    python3 -m venv "${VENV_DIR}" 2>&1 | tee -a "${LOG_FILE}"
    "${VENV_DIR}/bin/pip" install --upgrade pip --timeout 60 2>&1 | tee -a "${LOG_FILE}"
    log_msg "Virtual environment created at ${VENV_DIR}"
else
    log_msg "Virtual environment already exists, skipping"
fi

# Step 2: Prepare hermes-agent source (local fallback or network)
log_msg "Step 2/6: Preparing Hermes Agent source..."
AGENT_SOURCE_READY=false

if [ -d "${LOCAL_AGENT_DIR}" ] && [ -f "${LOCAL_AGENT_DIR}/pyproject.tom" -o -f "${LOCAL_AGENT_DIR}/setup.py" -o -f "${LOCAL_AGENT_DIR}/cli.py" ]; then
    log_msg "[LOCAL FALLBACK] Found local hermes-agent source at ${LOCAL_AGENT_DIR}"
    cp -r "${LOCAL_AGENT_DIR}" "${AGENT_DIR}"
    AGENT_SOURCE_READY=true
else
    log_msg "[NETWORK] No local source found, attempting network clone..."
    AGENT_URL="https://github.com/NousResearch/hermes-agent.git"
    
    for proxy in "${GH_PROXIES[@]}"; do
        if [ -n "${proxy}" ]; then
            FULL_URL="${proxy}${AGENT_URL}"
        else
            FULL_URL="${AGENT_URL}"
        fi
        
        log_msg "Trying git clone via: ${FULL_URL}"
        rm -rf "${AGENT_DIR}"
        if git clone --depth 1 "${FULL_URL}" "${AGENT_DIR}" 2>&1 | tee -a "${LOG_FILE}"; then
            if [ -f "${AGENT_DIR}/cli.py" -o -f "${AGENT_DIR}/pyproject.tom" ]; then
                log_msg "hermes-agent cloned successfully"
                cd "${AGENT_DIR}"
                git remote set-url origin "${AGENT_URL}"
                AGENT_SOURCE_READY=true
                break
            fi
        fi
    done
fi

if [ "${AGENT_SOURCE_READY}" = false ]; then
    error_exit "Failed to get hermes-agent source (network failed and no local fallback found). Please upload source to ${LOCAL_AGENT_DIR}"
fi

# Step 3: Prepare WebUI source (local fallback or network)
log_msg "Step 3/6: Preparing Hermes WebUI source..."
WEBUI_SOURCE_READY=false

if [ -d "${LOCAL_WEBUI_DIR}" ] && [ -f "${LOCAL_WEBUI_DIR}/package.json" -o -f "${LOCAL_WEBUI_DIR}/server.py" ]; then
    log_msg "[LOCAL FALLBACK] Found local hermes-webui source at ${LOCAL_WEBUI_DIR}"
    cp -r "${LOCAL_WEBUI_DIR}" "${WEBUI_DIR}"
    WEBUI_SOURCE_READY=true
else
    log_msg "[NETWORK] No local source found, attempting network clone..."
    CLONE_URL="https://github.com/nesquena/hermes-webui.git"
    
    for proxy in "${GH_PROXIES[@]}"; do
        if [ -n "${proxy}" ]; then
            FULL_URL="${proxy}${CLONE_URL}"
        else
            FULL_URL="${CLONE_URL}"
        fi
        
        log_msg "Trying git clone via: ${FULL_URL}"
        rm -rf "${WEBUI_DIR}"
        if git clone --depth 1 "${FULL_URL}" "${WEBUI_DIR}" 2>&1 | tee -a "${LOG_FILE}"; then
            if [ -f "${WEBUI_DIR}/server.py" -o -f "${WEBUI_DIR}/package.json" ]; then
                log_msg "Git clone successful"
                cd "${WEBUI_DIR}"
                git remote set-url origin "${CLONE_URL}"
                WEBUI_SOURCE_READY=true
                break
            fi
        fi
    done
fi

if [ "${WEBUI_SOURCE_READY}" = false ]; then
    error_exit "Failed to get hermes-webui source (network failed and no local fallback found). Please upload source to ${LOCAL_WEBUI_DIR}"
fi

# Step 4: Install hermes-agent dependencies
log_msg "Step 4/6: Installing hermes-agent dependencies..."
agent_deps_installed=1

for mirror in "${PIP_MIRRORS[@]}"; do
    log_msg "Trying pip install with mirror: ${mirror}"
    if "${VENV_DIR}/bin/pip" install -i "${mirror}" --trusted-host "$(echo "${mirror}" | awk -F'/' '{print $3}')" --timeout 120 -e "${AGENT_DIR}" 2>&1 | tee -a "${LOG_FILE}"; then
        log_msg "hermes-agent dependencies installed successfully"
        agent_deps_installed=0
        break
    fi
done

if [ "${agent_deps_installed}" -ne 0 ]; then
    error_exit "Failed to install hermes-agent dependencies from all mirrors"
fi

# Step 5: Install WebUI dependencies
log_msg "Step 5/6: Installing WebUI dependencies..."
if [ -f "${WEBUI_DIR}/requirements.txt" ]; then
    webui_deps_installed=1
    for mirror in "${PIP_MIRRORS[@]}"; do
        log_msg "Trying to install WebUI deps with mirror: ${mirror}"
        if "${VENV_DIR}/bin/pip" install -i "${mirror}" --trusted-host "$(echo "${mirror}" | awk -F'/' '{print $3}')" --timeout 120 -r "${WEBUI_DIR}/requirements.txt" 2>&1 | tee -a "${LOG_FILE}"; then
            log_msg "WebUI dependencies installed successfully"
            webui_deps_installed=0
            break
        fi
    done
    
    if [ "${webui_deps_installed}" -ne 0 ]; then
        log_msg "WARNING: Some WebUI dependencies may have failed to install"
    fi
fi

# Step 6: Clean up local fallback directories (optional, keep them for future re-install)
log_msg "Step 6/6: Finalizing installation..."
log_msg "Note: Local fallback directories (${LOCAL_AGENT_DIR}, ${LOCAL_WEBUI_DIR}) are preserved for future use."

# Fix permissions
chown -R hermes:hermes "${DATA_DIR}"
chmod 755 "${VENV_DIR}/bin/"

# Enable and start service
systemctl daemon-reload
systemctl enable hermes-app.service

log_msg "=== Installation Completed ==="
log_msg "Start the application from TOS App Center or run:"
log_msg "  systemctl start hermes-app"
log_msg "Access via: http://<NAS_IP>/hermes-app/"

exit 0
